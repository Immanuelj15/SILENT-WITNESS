# Silent Witness Configuration
APP_NAME=Silent Witness
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite:///./silent_witness.db

# Audio Processing Configuration
MAX_AUDIO_UPLOAD_SIZE_MB=25
SUPPORTED_AUDIO_FORMATS=["wav", "mp3", "m4a", "webm", "ogg"]
SAMPLE_RATE=16000
CHUNK_DURATION_SEC=3.0

# Risk Engine Configurable Weights (Must sum to 1.0)
WEIGHT_VOICE_RISK=0.35
WEIGHT_SOCIAL_ENGINEERING=0.25
WEIGHT_FRAUD_INTENT=0.20
WEIGHT_IDENTITY_RISK=0.10
WEIGHT_THREAT_RISK=0.10

# Risk Thresholds
THRESHOLD_LOW=30
THRESHOLD_SUSPICIOUS=60
THRESHOLD_HIGH=80

# Local AI / LLM Configuration
LLM_PROVIDER=local_agent
LLM_MODEL_NAME=Nemotron-3-Nano-4B-GGUF
LLM_API_BASE=http://localhost:8080/v1
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# Privacy & Security
ENABLE_AUDIO_STORAGE=False
AUTO_CLEANUP_TEMP_FILES=True
TEMP_STORAGE_DIR=./temp_audio
DATA_RETENTION_HOURS=24
